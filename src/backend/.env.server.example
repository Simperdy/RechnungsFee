# RechnungsFee Server-Modus — Beispiel-Env (OHNE echte Werte committen!)
# Im Homelab kommen die Werte als Dockhand-Umgebungsvariablen.
RECHNUNGSFEE_SERVER_MODE=1
RECHNUNGSFEE_BASE_DIR=/data

# OIDC gegen PocketID (eigener Client pro Instanz in PocketID anlegen,
# Authorization Code + PKCE, Redirect-URI exakt: https://<host>/api/auth/callback)
OIDC_ISSUER=https://id.pidpad.org
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=https://rechnungsfee.pidpad.org/api/auth/callback
# Komma-getrennte Allowlist — nur diese E-Mail-Adressen duerfen sich anmelden
OIDC_ALLOWED_EMAILS=

# Session-Signatur (32+ Bytes, zufaellig erzeugen: python -c "import secrets;print(secrets.token_urlsafe(32))")
SESSION_SECRET=
